<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>4.0.0</Version>
		<CompressionEnabled>false</CompressionEnabled>
		<!--
		SpawnDev.SpawnJS.BrowserExtension builds one extension per wwwroot/manifest.{platform}.json partial
		(chrome, firefox), each merged over wwwroot/manifest.json, with the app under {platform}/app/.
		-->
		<!-- AOT BY DEFAULT (TJ 2026-10-01): halves the per-frame host cost (DAv3 168x98: 43.8 -> 21.7 ms).
		     WasmStripILAfterAOT=false is REQUIRED: ILGPU compiles kernels from IL at runtime and .NET strips it after
		     AOT by default. Trimming is on (every SpawnDev library is trim safe). The AOT build takes over an hour on
		     one core; for a fast dev publish use -p:AnaglyphoholAot=false. -->
		<AnaglyphoholAot Condition="'$(AnaglyphoholAot)' == ''">true</AnaglyphoholAot>
		<RunAOTCompilation>$(AnaglyphoholAot)</RunAOTCompilation>
		<WasmStripILAfterAOT>false</WasmStripILAfterAOT>
		<!-- WasmDedup=false (TJ 2026-10-02: release builds too, for now). Deduplicated generic instantiations compile as
		     ONE single-threaded module (aot-instances) - 62 of the 65-80 min AOT publish. Off, they compile per assembly in
		     parallel: 4.5-5 min. MEASURED: same frame time; dotnet.native.wasm 35.5 -> 54.2 MB (stripped). -->
		<WasmDedup>false</WasmDedup>
		<!-- TrimMode=full (TJ 2026-10-02): the Blazor SDK defaults to partial (only IsTrimmable assemblies are trimmed).
		     MEASURED: managed 17.4 -> 15.9 MB (mostly the unused SpawnDev.Phonemizer), AOT build time UNCHANGED (65 min is
		     Mono's single-threaded aot-instances module - see PLANS.md). Every SpawnDev library is trim safe (enforced). -->
		<TrimMode>full</TrimMode>
		<!-- This app uses the BlazorWebAssembly SDK ONLY to compile .razor; it boots through SpawnJSAppBuilder, not
		     Blazor's JS runtime. SpawnJS.WebWorkers reads the Blazor SDK as "Blazor runtime" and turns the classic
		     bundle OFF by default, which drops main.classic.js (the background worker's entry) and main.module.js
		     (the content script's). Declare the non-Blazor boot. (2.1.19 ignored this setting from a csproj; fixed
		     in 2.2.0.) -->
		<SpawnJSWebWorkersBlazor>false</SpawnJSWebWorkersBlazor>
	</PropertyGroup>

	<ItemGroup>
		<!-- Full trimming would trim THIS assembly too, and its UI picks components by Type (DynamicComponent / LayoutView in
		     ContentOverlay + ExtensionPageApp - the IL2110/IL2111 warnings): trimmed, the overlay came up collapsed and 3D
		     never started (2026-10-02). Root the app (~150 KB); every library is still fully trimmed. -->
		<TrimmerRootAssembly Include="Anaglyphohol" />
	</ItemGroup>

	<ItemGroup>
		<!-- Direct reference so this WASM app gets the SpawnJS.WebWorkers build targets that produce main.classic.js (background worker) and main.module.js (content script) -->
		<PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.2.1" />
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.2-local.1" />
		<PackageReference Include="SpawnDev.SpawnJS.BrowserExtension" Version="2.2.2-local.2" />
		<PackageReference Include="SpawnDev.SpawnJS.RazorRenderer" Version="2.2.1-local.1" />
		<PackageReference Include="SpawnDev.SpawnJS.RazorUI" Version="2.2.1-local.1" />
		<!-- Depth estimation (DAv3 / DAv2) on the same GPU accelerator the 3D kernels run on -->
		<!-- EstimateGpuRawAsync(..., rawDepthOut, minMaxOut): depth + min/max stay on the device, no per-frame readback. -->
		<PackageReference Include="SpawnDev.ILGPU.ML" Version="5.3.3" />
		<!-- 5.3.2-local.6 (local SpawnDevPackages feed): WebGPU batched dispatch with scalar arenas + bind-group reuse.
		     Swap to the stable version when it ships. -->
		<PackageReference Include="SpawnDev.ILGPU" Version="5.3.3" />
		<!-- Account token signing / encryption (pure .NET) -->
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" />
	</ItemGroup>

	<!-- The depth models ship INSIDE the extension (wwwroot/models, served as app/models/...): DAv3 Small for images, Video
	     Depth Anything Small for video, both with FP16-stored weights (~51 + ~56 MB; FP32 compute). They are too big for
	     git, so nothing hosts them on GitHub: when one is missing, the build runs _tools/fetch-models.ps1, which downloads
	     DAv3 through hub.spawndev.com, takes or re-exports VDA, and converts both (see the script).
	     If they are still missing, fail loudly rather than ship an extension that cannot estimate depth. -->
	<PropertyGroup>
		<AnaglyphoholDAv3Model>$(MSBuildProjectDirectory)/wwwroot/models/depth-anything-v3-small/model.onnx</AnaglyphoholDAv3Model>
		<AnaglyphoholVdaModel>$(MSBuildProjectDirectory)/wwwroot/models/video-depth-anything-small/model.onnx</AnaglyphoholVdaModel>
	</PropertyGroup>
	<Target Name="AnaglyphoholRequireModels" BeforeTargets="BeforeBuild">
		<Exec Condition="'$(OS)' == 'Windows_NT' And (!Exists('$(AnaglyphoholDAv3Model)') Or !Exists('$(AnaglyphoholVdaModel)'))"
		      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../_tools/fetch-models.ps1&quot;" />
		<Error Condition="!Exists('$(AnaglyphoholDAv3Model)')"
		       Text="Depth model (Depth Anything 3 Small) missing from wwwroot/models. Run: powershell -ExecutionPolicy Bypass -File _tools/fetch-models.ps1" />
		<Error Condition="!Exists('$(AnaglyphoholVdaModel)')"
		       Text="Video depth model (Video Depth Anything Small) missing from wwwroot/models. Run: powershell -ExecutionPolicy Bypass -File _tools/fetch-models.ps1" />
	</Target>

</Project>
