<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>1.0.0</Version>
		<CompressionEnabled>false</CompressionEnabled>

		<!-- 
		Tells SpawnDev.BlazorJS.BrowserExtension to build for the specified platforms 
		Here we are building for Chrome and Firefox (currently the only tested platforms)
		Use manifest.json for shared configuration across platforms
		Manifest files with the pattern "manifest.{broder-platform}.json" will be merged with the main manifest.json file for paltform specific settings.
		Example: manifest.chrome.json, manifest.firefox.json, etc.
		-->
		<SpawnDevBrowserExtensionPlatforms>Chrome;Firefox</SpawnDevBrowserExtensionPlatforms>

		<!-- 
		Tells SpawnDev.BlazorJS.WebWorkers to build-time patch the Blazor WASM framework instead of runtime patching.
		Required for browser extension due to script restrictions
		-->
		<WebWorkerPatchFramework>true</WebWorkerPatchFramework>

		<!-- 
		If true the SpawnDev.BlazorJS.BrowserExtension.Build library will try to attach a debuggerdurign build to allow debugging the build process.
		This is useful for debugging build issues.
		-->
		<_DebugSpawnDevBrowserExtensionBuildTasks>false</_DebugSpawnDevBrowserExtensionBuildTasks>

		<!-- 
		Currently does nothing
		-->
		<SpawnDevBrowserExtensionVerbose>true</SpawnDevBrowserExtensionVerbose>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.22" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.22" PrivateAssets="all" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="8.0.22" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.BlazorJS" Version="2.46.0" />
		<PackageReference Include="SpawnDev.BlazorJS.WebWorkers" Version="2.25.0" />
		<PackageReference Include="SpawnDev.BlazorJS.TransformersJS.DepthAnythingV2" Version="1.6.0" />
		<PackageReference Include="SpawnDev.BlazorJS.Cryptography" Version="2.4.0" />
		<PackageReference Include="SpawnDev.Bink" Version="2.8.0" />
		<PackageReference Include="SpawnDev.BlazorJS.BrowserExtension" Version="1.0.1-preview.0" />
		<PackageReference Include="SpawnDev.BlazorJS.IndexRouting" Version="1.0.0" />
		<PackageReference Include="SpawnDev.BlazorJS.MultiView" Version="2.2.1" />
		<PackageReference Include="SpawnDev.BlazorJS.MultiView.Dimenco" Version="2.0.1" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="..\README.md" />
	</ItemGroup>
	
</Project>
