<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>4.0.0</Version>
		<CompressionEnabled>false</CompressionEnabled>
		<!--
		SpawnDev.SpawnJS.BrowserExtension builds one extension per wwwroot/manifest.{platform}.json partial
		(chrome, firefox), each merged over wwwroot/manifest.json, with the app under {platform}/app/.
		-->
		<!-- ILGPU compiles kernels FROM IL at runtime: AOT strips that IL. Trimming is safe (ILGPU is trim annotated). -->
		<RunAOTCompilation>false</RunAOTCompilation>
		<!-- This app uses the BlazorWebAssembly SDK ONLY to compile .razor; it boots through SpawnJSAppBuilder, not
		     Blazor's JS runtime. SpawnJS.WebWorkers reads the Blazor SDK as "Blazor runtime" and turns the classic
		     bundle OFF by default, which drops main.classic.js (the background worker's entry) and main.module.js
		     (the content script's). Declare the non-Blazor boot. (2.1.19 ignored this setting from a csproj; fixed
		     in 2.2.0.) -->
		<SpawnJSWebWorkersBlazor>false</SpawnJSWebWorkersBlazor>
	</PropertyGroup>

	<ItemGroup>
		<!-- Direct reference so this WASM app gets the SpawnJS.WebWorkers build targets that produce main.classic.js (background worker) and main.module.js (content script) -->
		<PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.2.0" />
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.0" />
		<PackageReference Include="SpawnDev.SpawnJS.BrowserExtension" Version="2.1.5" />
		<PackageReference Include="SpawnDev.SpawnJS.RazorRenderer" Version="2.1.11" />
		<PackageReference Include="SpawnDev.SpawnJS.RazorUI" Version="2.1.9" />
		<PackageReference Include="SpawnDev.SpawnJS.Cryptography" Version="2.0.2" />
		<!-- Depth estimation (DAv3 / DAv2) on the same GPU accelerator the 3D kernels run on -->
		<!-- 5.3.1-local.4: EstimateGpuRawAsync(..., rawDepthOut, minMaxOut) - depth + min/max stay on the device, no
		     per-frame readback. -local.N is staged in the local SpawnDevPackages feed; swap to the stable version when 5.3.1 ships. -->
		<PackageReference Include="SpawnDev.ILGPU.ML" Version="5.3.1-local.4" />
		<!-- The version ILGPU.ML 5.3.1-local.4 is built on (IExternalImageCopier: video/img -> GPU buffer, no readback). -->
		<PackageReference Include="SpawnDev.ILGPU" Version="5.3.1-local.1" />
		<!-- Account token signing / encryption (pure .NET) -->
		<PackageReference Include="SpawnDev.Bink" Version="2.8.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" />
	</ItemGroup>

	<!-- The depth models ship INSIDE the extension (wwwroot/models, served as app/models/...). They are too big for git
	     (DAv3 model.onnx_data is 104.7 MB, over GitHub's 100 MB file limit), so _tools/fetch-models.ps1 downloads them
	     through hub.spawndev.com. Fail the build loudly rather than ship an extension that cannot estimate depth. -->
	<Target Name="AnaglyphoholRequireModels" BeforeTargets="BeforeBuild">
		<Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/models/depth-anything-v3-small/onnx/model.onnx_data') Or !Exists('$(MSBuildProjectDirectory)/wwwroot/models/depth-anything-v2-small/onnx/model.onnx')"
			   Text="Depth models missing from wwwroot/models. Run: powershell -ExecutionPolicy Bypass -File _tools/fetch-models.ps1" />
	</Target>

</Project>
