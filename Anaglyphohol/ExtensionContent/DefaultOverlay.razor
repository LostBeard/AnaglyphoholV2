@using Bink
@attribute [ContentLocation(@"http")]

<div style="@(initComplete ? "" : "display: none;")">
    <div>
        <UIToggle Value="@AnaglyphEnabledGlobal" ValueChanged=@AnaglyphEnabledGlobal_OnClicked Styles="@(["opacity: 0.5; font-size: 20px;", "font-size: 20px;"])" Texts="@(["2D", "3D"])" Title="Global Enable" />
        <UIToggle Value="@AnaglyphImagesEnabledSite" ValueChanged=@AnaglyphImagesEnabledSite_OnClicked Text="" Title="Site Images Enable" Icon="image" IconStyles="@(["opacity: 0.5;", ""])" />
        <UIToggle Value="@AnaglyphVideosEnabledSite" ValueChanged=@AnaglyphVideosEnabledSite_OnClicked Text="" Title="Site Videos Enable" Icon="movie" IconStyles="@(["opacity: 0.5;", ""])" />
        <UIToggle Value="@(TrackedMedia.DrawStats ? 1 : 0)" ValueChanged=TrackedMedia.ToggleDrawStats Text="" Title="Toggle Stats" Icon="bar_chart" IconStyles="@(["opacity: 0.5;", ""])" />
        <UIToggle Value="@AnaglyphProfile" ValueChanged=@AnaglyphProfile_OnClicked Text="" Title="3D Mode" Images="@(TrackedMedia.RendererIcons)" />
        <UIToggle Value="@DepthModelIndex" ValueChanged=@DepthModel_OnClicked Title="Depth model: Depth Anything V3 / V2" Texts="@(["V3", "V2"])" Styles="@(["font-size: 14px;", "font-size: 14px;"])" />

        <UILink Href="https://www.spawndev.com/About" Title="@($"{Username} - SpawnDev.com")" Image="icon-128.png" ImageStyle="width: 28px; height: 28px;" />

        @foreach (var rs in TrackedMedia.RecommendedLinks)
        {
            <UILink Title="@rs.Title" Image="@rs.Image" ImageStyle="width: 28px; height: 28px;" Href="@rs.URL" />
        }

    </div>
    <div style="display: flex; flex-direction: row; justify-content: space-evenly;">
        <div>
            <div>3D Level</div>
            <UISlider Min="0" Max="1" Value="@TrackedMedia.Level3D" Step="0.05" Style="width: 150px;" Change="SetLevel3D" />
        </div>
        <div>
            <div>3D Focus</div>
            <UISlider Min="0" Max="1" Value="@TrackedMedia.Focus3D" Step="0.05" Style="width: 150px;" Change="SetFocus3D" />
        </div>
    </div>
    @if (TrackedMedia.Limited && TrackedMedia.CompatibleTrackedVideoItemsCount > 0 && TrackedMedia.AnaglyphVideosEnabled)
    {
        <div style="display: flex; flex-direction: row; justify-content: center;">
            <div>
                <UILink Href="https://www.spawndev.com/About" Text="3D Video Limited" Title="3D Video Limited. Click to for more information." />
            </div>
        </div>
    }
</div>

@code {
    string Username => string.IsNullOrEmpty(AppIdentityService.User.UsernameInClaim()) ? "Guest" : AppIdentityService.User.UsernameInClaim();

}