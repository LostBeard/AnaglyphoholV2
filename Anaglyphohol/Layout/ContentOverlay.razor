@using Anaglyphohol.Services
@* Dimenco fullscreen: hidden until the mouse moves (TrackedMedia.HideOverlayUi) - the display would read it as picture/depth. *@
@* Also hidden until this site's saved shown / minimized state is read: drawn before it, the toolbar showed minimized and
   then jumped to shown, and a click in between acted on the wrong state (MEASURED 2026-10-06, firefox-check). *@
<div class="extension-content" style="@(TrackedMedia.HideOverlayUi || !_stateLoaded ? "visibility: hidden;" : null)">
    <div class="ao-bar @(HideContent ? "ao-min" : "ao-exp") @(Active3D ? "" : "ao-off")" style="@BarStyle" @ref="_barRef">
        @* Dragging the arrows moves the whole toolbar sideways, off whatever it covers (TJ 2026-10-06). Not stored: every page
           load starts centered. A click without movement still shows / hides it. Native pointer events + pointer capture
           (ContentOverlay.razor.cs); :preventDefault on mousedown keeps a drag from selecting page text or starting a
           native image drag (SpawnJS.RazorRenderer 2.2.1 honours it; 2.2.0 wrote it into the DOM and did nothing). *@
        <div class="ao-toggle" @ref="_toggleRef" @onclick="ToggleClick" @onmousedown:preventDefault>
            <UIToggle ShowBusy="Loading" BusyProgress="LoadingProgress" Value="@HideContentI" ValueChanged=@Clicked Text="" Title="@(HideContent ? "Show the Anaglyphohol toolbar (drag to move it)" : "Hide the Anaglyphohol toolbar (drag to move it)")" Images="@ButtonIcons" />
        </div>
        @* hidden with CSS, never removed: removing it would dispose DefaultOverlay, and with it TrackedMedia (all 3D) *@
        <div class="ao-local">
            @if (ContentType != null)
            {
                <DynamicComponent @ref=dynamicComponent Type="ContentType" Parameters="ContentParameters" />
            }
        </div>
    </div>
</div>
