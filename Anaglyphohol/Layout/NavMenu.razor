@inject SpawnJSRuntime JS
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="index.html"><img src="red-blue-48.png" alt="" width="28" height="28" /> Anaglyphohol</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        @* plain links: extension pages are full page loads of index.html?$=<page> (no client-side router), so the current
           page is marked from the ?$= value *@
        <div class="nav-item px-3">
            <a class="nav-link @Active("")" href="index.html">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Get started
            </a>
        </div>
        @* Per-page settings stay in the page toolbar (as in the store version). Options holds only browser-wide switches that
           take effect on the next page load - today the experimental shared converter (2026-10-05). *@
        <div class="nav-item px-3">
            <a class="nav-link @Active("options")" href="index.html?$=options">
                <span class="bi bi-gear-nav-menu" aria-hidden="true"></span> Options
            </a>
        </div>
        <div class="nav-item px-3">
            <a class="nav-link @Active("systeminfo")" href="index.html?$=SystemInfo">
                <span class="bi bi-info-nav-menu" aria-hidden="true"></span> Info
            </a>
        </div>
    </nav>
    <div class="nav-footer px-3">
        <a href="https://www.spawndev.com/" target="_blank" rel="noopener">SpawnDev.com</a>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    string _page = "";

    protected override void OnInitialized()
    {
        using var location = JS.Get<Location>("location");
        foreach (var part in (location.Search ?? "").TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            if (part.StartsWith("$=")) _page = Uri.UnescapeDataString(part[2..]).ToLowerInvariant();
        }
        if (_page == "installed") _page = "";   // the get-started page, opened on install
    }

    string? Active(string page) => _page == page ? "active" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
