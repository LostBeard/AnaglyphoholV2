@* draggable=false: dragging the toolbar arrows moves the toolbar; a native image drag would take the mouse instead *@
<img src="@Url" class="@Class" style="@Style" draggable="false">
@code {
    [Parameter]
    public string Class { get; set; } = "";

    [Parameter]
    public string Style { get; set; } = "";

    [Parameter]
    public string Src { get; set; } = "";

    [Inject]
    BrowserExtensionService BrowserExtensionService { get; set; }

    string Url = "";

    protected override void OnParametersSet()
    {
        Url = BrowserExtensionService.GetURL(Src);
    }
}
