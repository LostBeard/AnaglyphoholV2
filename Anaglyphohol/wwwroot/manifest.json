{
  "name": "Anaglyphohol",
  "description": "Free 3D for web videos and images: anaglyph or glasses-free 2D+Z.",
  "version": "4.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "app/red-blue-16.png",
    "32": "app/red-blue-32.png",
    "48": "app/red-blue-48.png",
    "128": "app/red-blue-128.png",
    "192": "app/red-blue-192.png",
    "512": "app/red-blue-512.png"
  },
  "action": {
    "default_icon": "app/red-blue-192.png"
  },
  "options_ui": {
    "page": "app/index.html?$=options",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "js": [ "app/content.js" ],
      "matches": [ "<all_urls>" ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [ "<all_urls>" ],
      "resources": [
        "app/*"
      ]
    }
  ]
}
